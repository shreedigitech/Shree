<script>

/* =============================================================
   GLOBAL
============================================================= */

let normalLoanData = null;


/* =============================================================
   FORMAT INDIAN CURRENCY
============================================================= */

function money(value) {

    if (!Number.isFinite(value)) {
        value = 0;
    }

    return "₹" +
        Math.round(value)
        .toLocaleString("en-IN");

}


/* =============================================================
   GET NUMBER
============================================================= */

function getNumber(id) {

    const value =
        parseFloat(
            document.getElementById(id).value
        );

    return Number.isFinite(value)
        ? value
        : 0;

}


/* =============================================================
   REDUCING BALANCE EMI
============================================================= */

function calculateReducingEMI(
    principal,
    annualRate,
    months
) {

    if (months <= 0) {
        return 0;
    }

    const monthlyRate =
        annualRate / 12 / 100;

    if (monthlyRate === 0) {
        return principal / months;
    }

    return (
        principal *
        monthlyRate *
        Math.pow(
            1 + monthlyRate,
            months
        )
    ) / (
        Math.pow(
            1 + monthlyRate,
            months
        ) - 1
    );

}


/* =============================================================
   FLAT RATE EMI
============================================================= */

function calculateFlatEMI(
    principal,
    annualRate,
    months
) {

    if (months <= 0) {
        return 0;
    }

    const years =
        months / 12;

    const totalInterest =
        principal *
        annualRate /
        100 *
        years;

    return (
        principal +
        totalInterest
    ) / months;

}


/* =============================================================
   CREATE REDUCING SCHEDULE
============================================================= */

function createReducingSchedule(
    principal,
    annualRate,
    months,
    emi
) {

    const monthlyRate =
        annualRate / 12 / 100;

    let balance = principal;

    let totalInterest = 0;

    const schedule = [];


    for (
        let month = 1;
        month <= months;
        month++
    ) {

        const opening =
            balance;

        let interest =
            opening *
            monthlyRate;

        let principalPaid =
            emi - interest;


        if (principalPaid > balance) {

            principalPaid =
                balance;

        }


        balance -=
            principalPaid;


        if (balance < 0.01) {

            balance = 0;

        }


        totalInterest +=
            interest;


        schedule.push({

            month,

            opening,

            emi,

            interest,

            principal:
                principalPaid,

            prepayment:
                0,

            closing:
                balance

        });


        if (balance <= 0) {

            break;

        }

    }


    return {

        schedule,

        totalInterest,

        totalPayment:
            principal +
            totalInterest

    };

}


/* =============================================================
   CREATE FLAT SCHEDULE
============================================================= */

function createFlatSchedule(
    principal,
    annualRate,
    months,
    emi
) {

    const monthlyInterest =
        principal *
        annualRate /
        100 /
        12;

    let balance =
        principal;

    let totalInterest = 0;

    const schedule = [];


    for (
        let month = 1;
        month <= months;
        month++
    ) {

        const opening =
            balance;

        let interest =
            monthlyInterest;

        let principalPaid =
            emi - interest;


        if (principalPaid > balance) {

            principalPaid =
                balance;

        }


        balance -=
            principalPaid;


        if (balance < 0.01) {

            balance = 0;

        }


        totalInterest +=
            interest;


        schedule.push({

            month,

            opening,

            emi,

            interest,

            principal:
                principalPaid,

            prepayment:
                0,

            closing:
                balance

        });


        if (balance <= 0) {

            break;

        }

    }


    return {

        schedule,

        totalInterest,

        totalPayment:
            principal +
            totalInterest

    };

}


/* =============================================================
   CALCULATE NORMAL LOAN
============================================================= */

function calculateLoan() {

    const principal =
        getNumber("loanAmount");

    const annualRate =
        getNumber("annualRate");

    const months =
        Math.round(
            getNumber("tenure")
        );

    const method =
        document.getElementById(
            "interestMethod"
        ).value;


    if (
        principal <= 0 ||
        months <= 0 ||
        annualRate < 0
    ) {

        alert(
            "Please enter valid loan details."
        );

        return null;

    }


    let emi;


    if (method === "reducing") {

        emi =
            calculateReducingEMI(
                principal,
                annualRate,
                months
            );

    } else {

        emi =
            calculateFlatEMI(
                principal,
                annualRate,
                months
            );

    }


    let data;


    if (method === "reducing") {

        data =
            createReducingSchedule(
                principal,
                annualRate,
                months,
                emi
            );

    } else {

        data =
            createFlatSchedule(
                principal,
                annualRate,
                months,
                emi
            );

    }


    return {

        principal,

        annualRate,

        months,

        method,

        emi,

        totalInterest:
            data.totalInterest,

        totalPayment:
            data.totalPayment,

        schedule:
            data.schedule

    };

}


/* =============================================================
   MAIN CALCULATION
============================================================= */

function calculateAll() {

    const data =
        calculateLoan();


    if (!data) {
        return;
    }


    normalLoanData =
        data;


    document.getElementById(
        "emiResult"
    ).textContent =
        money(data.emi);


    document.getElementById(
        "interestResult"
    ).textContent =
        money(data.totalInterest);


    document.getElementById(
        "paymentResult"
    ).textContent =
        money(data.totalPayment);


    const interestRatio =
        data.totalInterest /
        data.principal *
        100;


    document.getElementById(
        "ratioResult"
    ).textContent =
        interestRatio.toFixed(2) +
        "%";


    compareExistingEMI(
        data.emi
    );


    renderSchedule(
        data.schedule
    );


    compareMethods(
        data
    );


    calculatePrepayment();

}


/* =============================================================
   EXISTING EMI COMPARISON
============================================================= */

function compareExistingEMI(
    calculatedEMI
) {

    const existing =
        getNumber("existingEmi");

    const element =
        document.getElementById(
            "existingEmiResult"
        );


    if (existing <= 0) {

        element.innerHTML =
            "Enter an existing EMI to compare it with the calculated EMI.";

        return;

    }


    const difference =
        existing -
        calculatedEMI;


    if (Math.abs(difference) < 1) {

        element.innerHTML =
            "<b>Existing EMI:</b> " +
            money(existing) +
            "<br><b>Calculated EMI:</b> " +
            money(calculatedEMI) +
            "<br>The amounts are approximately the same.";

    }

    else if (difference > 0) {

        element.innerHTML =
            "<b>Existing EMI:</b> " +
            money(existing) +
            "<br><b>Calculated EMI:</b> " +
            money(calculatedEMI) +
            "<br>Your entered EMI is approximately " +
            "<b>" +
            money(difference) +
            "</b> higher.";

    }

    else {

        element.innerHTML =
            "<b>Existing EMI:</b> " +
            money(existing) +
            "<br><b>Calculated EMI:</b> " +
            money(calculatedEMI) +
            "<br>Your entered EMI is approximately " +
            "<b>" +
            money(Math.abs(difference)) +
            "</b> lower.";

    }

}


/* =============================================================
   COMPARE FLAT AND REDUCING
============================================================= */

function compareMethods(
    currentData
) {

    const P =
        currentData.principal;

    const rate =
        currentData.annualRate;

    const months =
        currentData.months;


    const reducingEMI =
        calculateReducingEMI(
            P,
            rate,
            months
        );


    const flatEMI =
        calculateFlatEMI(
            P,
            rate,
            months
        );


    const reducing =
        createReducingSchedule(
            P,
            rate,
            months,
            reducingEMI
        );


    const flat =
        createFlatSchedule(
            P,
            rate,
            months,
            flatEMI
        );


    const difference =
        flat.totalInterest -
        reducing.totalInterest;


    document.getElementById(
        "methodComparison"
    ).innerHTML =

        "<b>Reducing Balance</b><br>" +

        "EMI: " +
        money(reducingEMI) +
        "<br>" +

        "Estimated interest: " +
        money(reducing.totalInterest) +

        "<br><br>" +

        "<b>Flat Rate</b><br>" +

        "EMI: " +
        money(flatEMI) +
        "<br>" +

        "Estimated interest: " +
        money(flat.totalInterest) +

        "<br><br>" +

        "Difference in estimated interest: " +

        "<b>" +
        money(Math.max(0, difference)) +
        "</b>" +

        "<br><br>" +

        "<small>" +
        "This comparison is mathematical only. " +
        "Actual lender calculations may differ." +
        "</small>";

}


/* =============================================================
   RENDER SCHEDULE
============================================================= */

function renderSchedule(
    schedule
) {

    const tbody =
        document.getElementById(
            "scheduleBody"
        );


    tbody.innerHTML = "";


    schedule.forEach(
        row => {

            const tr =
                document.createElement(
                    "tr"
                );


            tr.innerHTML = `

                <td>${row.month}</td>

                <td>${money(row.opening)}</td>

                <td>${money(row.emi)}</td>

                <td>${money(row.interest)}</td>

                <td>${money(row.principal)}</td>

                <td>${money(row.prepayment)}</td>

                <td>${money(row.closing)}</td>

            `;


            tbody.appendChild(tr);

        }
    );

}


/* =============================================================
   PREPAYMENT STRATEGY
============================================================= */

function calculatePrepayment() {

    if (!normalLoanData) {

        normalLoanData =
            calculateLoan();

    }


    if (!normalLoanData) {
        return;
    }


    const P =
        normalLoanData.principal;

    const rate =
        normalLoanData.annualRate;

    const tenure =
        normalLoanData.months;

    const method =
        normalLoanData.method;


    const emi =
        normalLoanData.emi;


    const prepaymentMonths = [

        Math.round(
            getNumber(
                "prepaymentMonth1"
            )
        ),

        Math.round(
            getNumber(
                "prepaymentMonth2"
            )
        ),

        Math.round(
            getNumber(
                "prepaymentMonth3"
            )
        )

    ]
    .filter(
        month =>
            month > 0 &&
            month <= tenure
    );


    const prepaymentPercent =
        Math.min(
            100,
            Math.max(
                0,
                getNumber(
                    "prepaymentPercent"
                )
            )
        );


    const foreclosureMonth =
        Math.round(
            getNumber(
                "foreclosureMonth"
            )
        );


    if (
        foreclosureMonth <= 0 ||
        foreclosureMonth > tenure
    ) {

        alert(
            "Foreclosure month must be between 1 and the loan tenure."
        );

        return;

    }


    let balance =
        P;

    let totalInterest =
        0;

    let totalPrepayment =
        0;

    const strategy = [];


    const monthlyRate =
        rate / 12 / 100;


    for (
        let month = 1;
        month <= foreclosureMonth;
        month++
    ) {

        if (balance <= 0) {
            break;
        }


        const opening =
            balance;


        let interest;


        if (method === "reducing") {

            interest =
                balance *
                monthlyRate;

        } else {

            interest =
                P *
                monthlyRate;

        }


        let principalPaid =
            emi -
            interest;


        if (principalPaid < 0) {

            principalPaid = 0;

        }


        if (principalPaid > balance) {

            principalPaid =
                balance;

        }


        balance -=
            principalPaid;


        totalInterest +=
            interest;


        let prepayment =
            0;


        if (
            prepaymentMonths.includes(
                month
            ) &&
            balance > 0
        ) {

            prepayment =
                balance *
                prepaymentPercent /
                100;


            balance -=
                prepayment;


            totalPrepayment +=
                prepayment;

        }


        if (balance < 0.01) {

            balance = 0;

        }


        strategy.push({

            month,

            opening,

            emi,

            interest,

            principal:
                principalPaid,

            prepayment,

            closing:
                balance

        });

    }


    const foreclosureBalance =
        balance;


    const foreclosureRate =
        getNumber(
            "foreclosureRate"
        );


    const foreclosureCharge =
        foreclosureBalance *
        foreclosureRate /
        100;


    const finalClosure =
        foreclosureBalance +
        foreclosureCharge;


    const normalInterest =
        normalLoanData.totalInterest;


    const estimatedSaving =
        Math.max(
            0,
            normalInterest -
            totalInterest
        );


    document.getElementById(
        "foreclosureBalance"
    ).textContent =
        money(
            foreclosureBalance
        );


    document.getElementById(
        "foreclosureCharge"
    ).textContent =
        money(
            foreclosureCharge
        );


    document.getElementById(
        "closureAmount"
    ).textContent =
        money(
            finalClosure
        );


    document.getElementById(
        "savedInterest"
    ).textContent =
        money(
            estimatedSaving
        );


    document.getElementById(
        "prepaymentMessage"
    ).innerHTML =

        "Total simulated prepayments: " +
        "<b>" +
        money(totalPrepayment) +
        "</b>" +

        "<br>" +

        "Estimated interest paid before foreclosure: " +
        "<b>" +
        money(totalInterest) +
        "</b>" +

        "<br><br>" +

        "<b>Important:</b> " +
        "The foreclosure amount shown is an estimate. " +
        "Your lender may calculate interest, fees, taxes and " +
        "prepayment charges differently.";

    renderSchedule(
        strategy
    );

}


